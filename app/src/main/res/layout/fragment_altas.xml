            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_estandar"
                android:text="@string/AltaRutasFavorita"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLatitud"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_estandar"
                android:hint="@string/AltaRutasLatitud"
                app:suffixText="°">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/AltaRutasLatitudEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLongitud"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_estandar"
                android:hint="@string/AltaRutasLongitud"
                app:suffixText="°">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/AltaRutasLongitudEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/AltaRutasGuardarButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margen_estandar"
                android:layout_marginBottom="@dimen/margen_estandar"
                android:text="@string/AltaRutasTextoBoton"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                />
