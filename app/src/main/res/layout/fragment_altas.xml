            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/AltaRutasDificultad"
                android:gravity="center"
                style="@style/AppTextMeta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content">
                <RatingBar
                    android:id="@+id/ratingBar3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1"
                    android:progressTint="?attr/colorPrimary" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutDistancia"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_estandar"
                android:hint="@string/AltaRutasDistancia"
                app:suffixText="km">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/AltaRutasDistanciaEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutDescripcion"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_estandar"
                android:hint="@string/AltaRutasDescripcion">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/AltaRutasDescripcionEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top|start" />

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutNotas"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margen_estandar"
                android:hint="@string/AltaRutasNotas">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/AltaRutasNotasEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top|start" />

            </com.google.android.material.textfield.TextInputLayout>
